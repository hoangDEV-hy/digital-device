# Database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=digital_marketplace
DB_USER=root
DB_PASS=pass

# JWT
JWT_SECRET=your_jwt_secret
JWT_EXPIRES_IN=1h
REFRESH_TOKEN_SECRET=your_refresh_secret

# Server
PORT=3000

# Sync DB (true to enable sequelize.sync at startup)
DB_SYNC=true

# Seed admin credentials (used when DB sync runs and admin not present)
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=Admin1234
